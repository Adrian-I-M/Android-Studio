<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_gradient"
    tools:context=".MainActivity">

    <!-- AVATAR DE USUARIO CON FONDO BLANCO SUPERIOR IZQUIERDA -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/userAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:srcCompat="@android:drawable/ic_menu_myplaces" /> <!-- Cambia por @drawable/tu_foto_perfil si la tienes -->

    <FrameLayout
        android:id="@+id/btnNotificationContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#FFFFFF"
        android:elevation="3dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ICONO DE LA CAMPANA (AQUÍ CONTROLAS SU TAMAÑO) -->
        <ImageView
            android:id="@+id/ivBellIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            app:srcCompat="@android:drawable/ic_popup_reminder"
            app:tint="#1A1A1A" />

    </FrameLayout>

    <!-- TÍTULO BIENVENIDA -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-condensed-light"
        android:text="Welcome!"
        android:textColor="#262626"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/userAvatar" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Rajesh"
        android:textColor="#1A1A1A"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:text="How is it going today?"
        android:textColor="#85929E"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <!-- BOTÓN URGENT CARE -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FFA025"
        android:text="Urgent Care"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="25dp"
        app:icon="@android:drawable/ic_lock_idle_alarm"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <!-- IMAGEN DOCTOR -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="230dp"
        android:layout_height="270dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/doctor" />

    <!-- HOJA INFERIOR REDONDEADA BLANCA -->
    <View
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:background="@drawable/bg_rounded_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- NUESTROS SERVICIOS -->
    <TextView
        android:id="@+id/tvServicesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Our Services"
        android:textColor="#1A1A1A"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomAppBar" />

    <!-- SERVICIO: CONSULTATION -->
    <ImageButton
        android:id="@+id/btnConsultation"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Consultation"
        android:padding="20dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/btnMedicines"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvServicesHeader"
        app:srcCompat="@drawable/baseline_medical_services_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvConsultation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Consultation"
        android:textColor="#333333"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/btnConsultation"
        app:layout_constraintStart_toStartOf="@+id/btnConsultation"
        app:layout_constraintTop_toBottomOf="@+id/btnConsultation" />

    <!-- SERVICIO: MEDICINES -->
    <ImageButton
        android:id="@+id/btnMedicines"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Medicines"
        android:padding="20dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/btnConsultation"
        app:layout_constraintEnd_toStartOf="@+id/btnAmbulance"
        app:layout_constraintStart_toEndOf="@+id/btnConsultation"
        app:layout_constraintTop_toTopOf="@+id/btnConsultation"
        app:srcCompat="@drawable/twotone_medication_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvMedicines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Medicines"
        android:textColor="#333333"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/btnMedicines"
        app:layout_constraintStart_toStartOf="@+id/btnMedicines"
        app:layout_constraintTop_toBottomOf="@+id/btnMedicines" />

    <!-- SERVICIO: AMBULANCE -->
    <ImageButton
        android:id="@+id/btnAmbulance"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Ambulance"
        android:padding="20dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/btnMedicines"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnMedicines"
        app:layout_constraintTop_toTopOf="@+id/btnMedicines"
        app:srcCompat="@drawable/baseline_airport_shuttle_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvAmbulance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ambulance"
        android:textColor="#333333"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/btnAmbulance"
        app:layout_constraintStart_toStartOf="@+id/btnAmbulance"
        app:layout_constraintTop_toBottomOf="@+id/btnAmbulance" />

    <!-- CABECERA APPOINTMENT -->
    <LinearLayout
        android:id="@+id/layoutAppointmentHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConsultation">

        <TextView
            android:id="@+id/textViewAppointment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Appointment"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSeeAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="See All"
            android:textColor="#2F80ED"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TARJETA APPOINTMENT -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAppointment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAppointmentHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <View
                android:id="@+id/blueIndicator"
                android:layout_width="4dp"
                android:layout_height="0dp"
                android:background="#2D7FF3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:text="Appointment date"
                android:textColor="#9EAEBE"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivOptions"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="16dp"
                android:rotation="90"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="@id/tvDateLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDateLabel"
                app:tint="#8A95A5" />

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:text="🕒  Wed Nov 20  •  8:00 - 8:30 AM"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toBottomOf="@id/tvDateLabel" />

            <View
                android:id="@+id/dividerLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="#F3F5F8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDateTime" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoctorAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toBottomOf="@id/dividerLine"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:srcCompat="@drawable/doctor" />

            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:text="Dr. Prem Tiwari"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivDoctorAvatar"
                app:layout_constraintTop_toTopOf="@id/ivDoctorAvatar" />

            <TextView
                android:id="@+id/tvDoctorSpecialty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:text="Orthopedic"
                android:textColor="#8E9AA7"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivDoctorAvatar"
                app:layout_constraintTop_toBottomOf="@id/tvDoctorName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- BARRA INFERIOR DE NAVEGACIÓN -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 1. HOME -->
        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_menu_view"
            app:tint="#2F80ED" />

        <!-- 2. RECORDS -->
        <ImageButton
            android:id="@+id/navRecords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_menu_agenda"
            app:tint="#8E9AA7" />

        <!-- 3. BOTÓN CENTRAL DE MÁS (+) -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center">

            <ImageButton
                android:id="@+id/button5"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#0F2B5C"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:srcCompat="@android:drawable/ic_input_add"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <!-- 4. CHAT -->
        <ImageButton
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/stat_notify_chat"
            app:tint="#8E9AA7" />

        <!-- 5. PERFIL -->
        <ImageButton
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_menu_myplaces"
            app:tint="#8E9AA7" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>