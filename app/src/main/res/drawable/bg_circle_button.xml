<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Fondo blanco de la circunferencia -->
    <solid android:color="#FFFFFF" />

    <!-- Borde muy fino y de un azul muy suave (como el de la referencia) -->
    <stroke
        android:width="1dp"
        android:color="#E3EEFF" />

    <!-- Asegura que el botón mantenga proporciones circulares uniformes -->
    <size
        android:width="70dp"
        android:height="70dp" />
</shape>