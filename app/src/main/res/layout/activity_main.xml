<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_gradient"
    tools:context=".MainActivity">

    <!-- RELOJ SUPERIOR -->
    <TextClock
        android:id="@+id/textClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BOTON FLOTANTE SUPERIOR IZQUIERDA -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:fabCustomSize="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textClock"
        app:srcCompat="@android:drawable/alert_light_frame" />

    <!-- BOTON CIRCULAR SUPERIOR DERECHA -->
    <Button
        android:id="@+id/button4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="#70529C"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textClock" />

    <!-- TITULO BIENVENIDA -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Welcome!"
        android:textColor="#1A1A1A"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/floatingActionButton" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="Rajesh"
        android:textColor="#1A1A1A"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="How is it going today?"
        android:textColor="#555555"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <!-- BOTON URGENT CARE -->
    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#FF5722"
        android:text="Urgent Care"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:cornerRadius="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <!-- IMAGEN DOCTOR -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="220dp"
        android:layout_height="270dp"
        android:scaleType="fitEnd"
        app:layout_constraintBottom_toTopOf="@+id/bottomAppBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/doctor" />

    <!-- HOJA INFERIOR REDONDEADA -->
    <View
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:background="@drawable/bg_rounded_sheet"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- NUESTROS SERVICIOS -->
    <TextView
        android:id="@+id/tvServicesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Our Services"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomAppBar" />

    <!-- SERVICIO: CONSULTATION -->
    <ImageButton
        android:id="@+id/btnConsultation"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Consultation"
        android:padding="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toStartOf="@+id/btnMedicines"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvServicesHeader"
        app:srcCompat="@drawable/baseline_medical_services_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvConsultation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Consultation"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/btnConsultation"
        app:layout_constraintStart_toStartOf="@+id/btnConsultation"
        app:layout_constraintTop_toBottomOf="@+id/btnConsultation" />

    <!-- SERVICIO: MEDICINES -->
    <ImageButton
        android:id="@+id/btnMedicines"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Medicines"
        android:padding="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/btnConsultation"
        app:layout_constraintEnd_toStartOf="@+id/btnAmbulance"
        app:layout_constraintStart_toEndOf="@+id/btnConsultation"
        app:layout_constraintTop_toTopOf="@+id/btnConsultation"
        app:srcCompat="@drawable/twotone_medication_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvMedicines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Medicines"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/btnMedicines"
        app:layout_constraintStart_toStartOf="@+id/btnMedicines"
        app:layout_constraintTop_toBottomOf="@+id/btnMedicines" />

    <!-- SERVICIO: AMBULANCE -->
    <ImageButton
        android:id="@+id/btnAmbulance"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Ambulance"
        android:padding="16dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/btnMedicines"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnMedicines"
        app:layout_constraintTop_toTopOf="@+id/btnMedicines"
        app:srcCompat="@drawable/baseline_airport_shuttle_24"
        app:tint="#2F80ED" />

    <TextView
        android:id="@+id/tvAmbulance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ambulance"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/btnAmbulance"
        app:layout_constraintStart_toStartOf="@+id/btnAmbulance"
        app:layout_constraintTop_toBottomOf="@+id/btnAmbulance" />

    <!-- CABECERA APPOINTMENT -->
    <LinearLayout
        android:id="@+id/layoutAppointmentHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConsultation">

        <TextView
            android:id="@+id/textViewAppointment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Appointment"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSeeAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="See All"
            android:textColor="#2F80ED"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- TARJETA APPOINTMENT -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAppointment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAppointmentHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/blueIndicator"
                android:layout_width="4dp"
                android:layout_height="0dp"
                android:background="#2F80ED"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="Appointment date"
                android:textColor="#8A95A5"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivOptions"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="16dp"
                android:rotation="90"
                android:src="@android:drawable/ic_menu_more"
                app:layout_constraintBottom_toBottomOf="@id/tvDateLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDateLabel"
                app:tint="#8A95A5" />

            <TextView
                android:id="@+id/tvDateTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:text="🕒  Wed Nov 20  •  8:00 - 8:30 AM"
                android:textColor="#1A1A1A"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toBottomOf="@id/tvDateLabel" />

            <View
                android:id="@+id/dividerLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="#F0F2F5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toBottomOf="@id/tvDateTime" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDoctorAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toEndOf="@id/blueIndicator"
                app:layout_constraintTop_toBottomOf="@id/dividerLine"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:srcCompat="@drawable/doctor" />

            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="16dp"
                android:text="Dr. Prem Tiwari"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivDoctorAvatar"
                app:layout_constraintTop_toTopOf="@id/ivDoctorAvatar" />

            <TextView
                android:id="@+id/tvDoctorSpecialty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:text="Orthopedic"
                android:textColor="#8A95A5"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivDoctorAvatar"
                app:layout_constraintTop_toBottomOf="@id/tvDoctorName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- BARRA INFERIOR DE NAVEGACION -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/imageButton10"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/alert_light_frame" />

        <ImageButton
            android:id="@+id/imageButton9"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/alert_light_frame" />

        <Button
            android:id="@+id/button5"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:backgroundTint="#70529C"
            app:cornerRadius="28dp" />

        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/alert_light_frame" />

        <ImageButton
            android:id="@+id/imageButton5"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/alert_light_frame" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>